  m_Script: {fileID: 11500000, guid: 9d7ea898f0605b46b3aa06c5dd60dfb1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HollowCurrent.Interactable
  Kind: 1
  Label: Case briefing
  Body: "HOLLOW CURRENT / CASE 014\n\nBellwether House. The Harrow family is safely
    away. Identify the presence and seal its anchor.\n\n1 Induction: hold left mouse
    while aiming at a signal.\n2 Ultraviolet: light reveals persistent traces; hold
    to record.\n3 EVP recorder: press left mouse, then stay quiet for a reply.\nF
    torch \xB7 R radio \xB7 J journal \xB7 E interact \xB7 Shift sprint \xB7 Ctrl
    crouch.\n\nEscape always releases the mouse. Click Resume to return. No microphone
    is used."
  HidePoint: {x: 0, y: 0, z: 0}
  ExitPoint: {x: 0, y: 0, z: 0}
  Door: {fileID: 0}
  Circuit: {fileID: 0}
  RelicIndex: -1
  Art: {fileID: 0}
