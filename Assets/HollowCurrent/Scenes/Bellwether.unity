  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d7ea898f0605b46b3aa06c5dd60dfb1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HollowCurrent.Interactable
  Kind: 1
  Label: Child's drawing
  Body: 'A HOUSE WITH HANDS


    A hand is traced beside the bedroom window. Beneath
    it: ''She finds me when I leave the light on.''


    In the margin: ''When the
    little song ends, she goes quiet. Dad keeps winding it back. Please let it finish.'''
