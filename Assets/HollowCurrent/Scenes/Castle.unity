--- !u!114 &93624533
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 93624531}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d7ea898f0605b46b3aa06c5dd60dfb1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HollowCurrent.Interactable
  Kind: 1
  Label: Kitchen tally
  Body: 'Tally cut into the table:


    Monday, six places set.

    Tuesday, six
    places set.

    Wednesday, five.

    Thursday, four, and the knives would not
    stay in the block.

    Friday, one place, and it was not set by us.'
